/**
 * BlockESP Module - Highlight specific blocks
 */
var blockESPScript = registerScript({
    name: "BlockESP",
    version: "1.0.0",
    authors: ["CustomDev"]
});

blockESPScript.registerModule({
    name: "BlockESP",
    description: "Highlights specific blocks through walls",
    category: "Render",
    settings: {
        range: Setting.integer({
            name: "Range",
            default: 50,
            min: 10,
            max: 100
        }),
        mode: Setting.list({
            name: "Mode",
            default: "Box",
            values: ["Box", "Outline", "Both"]
        }),
        ores: Setting.boolean({
            name: "Ores",
            default: true
        }),
        spawners: Setting.boolean({
            name: "Spawners",
            default: true
        }),
        chests: Setting.boolean({
            name: "Chests",
            default: true
        }),
        enderChests: Setting.boolean({
            name: "EnderChests",
            default: true
        }),
        portals: Setting.boolean({
            name: "Portals",
            default: false
        }),
        beds: Setting.boolean({
            name: "Beds",
            default: false
        }),
        customBlocks: Setting.text({
            name: "CustomBlocks",
            default: ""
        })
    }
}, function(module) {
    var blockCache = [];
    var lastUpdate = 0;
    var updateInterval = 1000; // Update every second
    
    var oreColors = {
        "diamond_ore": 0xFF00FFFF,
        "deepslate_diamond_ore": 0xFF00FFFF,
        "emerald_ore": 0xFF00FF00,
        "deepslate_emerald_ore": 0xFF00FF00,
        "gold_ore": 0xFFFFD700,
        "deepslate_gold_ore": 0xFFFFD700,
        "iron_ore": 0xFFD4D4D4,
        "deepslate_iron_ore": 0xFFD4D4D4,
        "coal_ore": 0xFF404040,
        "deepslate_coal_ore": 0xFF404040,
        "lapis_ore": 0xFF0000FF,
        "deepslate_lapis_ore": 0xFF0000FF,
        "redstone_ore": 0xFFFF0000,
        "deepslate_redstone_ore": 0xFFFF0000,
        "ancient_debris": 0xFF8B4513,
        "nether_gold_ore": 0xFFFFD700
    };
    
    module.on("enable", function() {
        Chat.print("§a[BlockESP] §fEnabled!");
        updateBlockCache();
    });
    
    module.on("disable", function() {
        Chat.print("§c[BlockESP] §fDisabled!");
        blockCache = [];
    });
    
    module.on("update", function() {
        var currentTime = Date.now();
        if (currentTime - lastUpdate > updateInterval) {
            updateBlockCache();
            lastUpdate = currentTime;
        }
    });
    
    module.on("render3D", function(event) {
        if (blockCache.length == 0) return;
        
        RenderUtils.prepareGL();
        GL11.glLineWidth(1.5);
        
        var rm = mc.getRenderManager();
        
        for (var i = 0; i < blockCache.length; i++) {
            var block = blockCache[i];
            
            var x = block.x - rm.renderPosX;
            var y = block.y - rm.renderPosY;
            var z = block.z - rm.renderPosZ;
            
            var bb = new AxisAlignedBB(x, y, z, x + 1, y + 1, z + 1);
            
            var mode = module.settings.mode.get();
            
            if (mode == "Box" || mode == "Both") {
                RenderUtils.drawFilledBox(bb, (block.color & 0x00FFFFFF) | 0x40000000);
            }
            
            if (mode == "Outline" || mode == "Both") {
                RenderUtils.drawBox(bb, block.color);
            }
        }
        
        RenderUtils.releaseGL();
    });
    
    function updateBlockCache() {
        blockCache = [];
        
        var player = mc.thePlayer;
        if (player == null) return;
        
        var range = module.settings.range.get();
        var playerX = Math.floor(player.posX);
        var playerY = Math.floor(player.posY);
        var playerZ = Math.floor(player.posZ);
        
        for (var x = playerX - range; x <= playerX + range; x++) {
            for (var y = Math.max(0, playerY - range); y <= Math.min(255, playerY + range); y++) {
                for (var z = playerZ - range; z <= playerZ + range; z++) {
                    var block = BlockUtils.getBlock(x, y, z);
                    var blockName = getBlockName(block);
                    var color = getBlockColor(block, blockName);
                    
                    if (color != -1) {
                        blockCache.push({x: x, y: y, z: z, color: color});
                    }
                }
            }
        }
    }
    
    function getBlockName(block) {
        var registry = Block.REGISTRY;
        var resourceLocation = registry.getNameForObject(block);
        if (resourceLocation != null) {
            return resourceLocation.getResourcePath();
        }
        return "";
    }
    
    function getBlockColor(block, blockName) {
        // Check ores
        if (module.settings.ores.get()) {
            if (oreColors[blockName] != null) {
                return oreColors[blockName];
            }
        }
        
        // Check spawners
        if (module.settings.spawners.get()) {
            if (blockName == "spawner" || blockName == "mob_spawner") {
                return 0xFFFF00FF;
            }
        }
        
        // Check chests
        if (module.settings.chests.get()) {
            if (blockName == "chest" || blockName == "trapped_chest") {
                return 0xFFFFAA00;
            }
        }
        
        // Check ender chests
        if (module.settings.enderChests.get()) {
            if (blockName == "ender_chest") {
                return 0xFF800080;
            }
        }
        
        // Check portals
        if (module.settings.portals.get()) {
            if (blockName == "nether_portal" || blockName == "end_portal") {
                return 0xFF9400D3;
            }
        }
        
        // Check beds
        if (module.settings.beds.get()) {
            if (blockName.indexOf("bed") != -1) {
                return 0xFFFF6961;
            }
        }
        
        // Check custom blocks
        var customBlocks = module.settings.customBlocks.get();
        if (customBlocks != "") {
            var blocks = customBlocks.split(",");
            for (var i = 0; i < blocks.length; i++) {
                if (blockName == blocks[i].trim()) {
                    return 0xFFFFFFFF;
                }
            }
        }
        
        return -1;
    }
});

/**
 * Tracers Module - Lines to entities
 */
var tracersScript = registerScript({
    name: "Tracers",
    version: "1.0.0",
    authors: ["CustomDev"]
});

tracersScript.registerModule({
    name: "Tracers",
    description: "Draws lines to entities",
    category: "Render",
    settings: {
        range: Setting.float({
            name: "Range",
            default: 100.0,
            min: 10.0,
            max: 256.0
        }),
        lineWidth: Setting.float({
            name: "LineWidth",
            default: 1.0,
            min: 0.5,
            max: 5.0
        }),
        players: Setting.boolean({
            name: "Players",
            default: true
        }),
        mobs: Setting.boolean({
            name: "Mobs",
            default: false
        }),
        animals: Setting.boolean({
            name: "Animals",
            default: false
        }),
        items: Setting.boolean({
            name: "Items",
            default: false
        }),
        invisibles: Setting.boolean({
            name: "Invisibles",
            default: false
        }),
        colorMode: Setting.list({
            name: "ColorMode",
            default: "Distance",
            values: ["Distance", "Health", "Static"]
        }),
        staticColor: Setting.color({
            name: "StaticColor",
            default: 0xFFFF0000
        })
    }
}, function(module) {
    module.on("enable", function() {
        Chat.print("§a[Tracers] §fEnabled!");
    });
    
    module.on("disable", function() {
        Chat.print("§c[Tracers] §fDisabled!");
    });
    
    module.on("render3D", function(event) {
        var player = mc.thePlayer;
        var world = mc.theWorld;
        if (player == null || world == null) return;
        
        RenderUtils.prepareGL();
        GL11.glLineWidth(module.settings.lineWidth.get());
        
        var rm = mc.getRenderManager();
        var pt = event.getPartialTicks();
        
        var eyeHeight = player.getEyeHeight();
        
        var entities = world.loadedEntityList;
        for (var i = 0; i < entities.size(); i++) {
            var entity = entities.get(i);
            
            if (!isValidEntity(entity)) continue;
            
            var dist = player.getDistanceToEntity(entity);
            if (dist > module.settings.range.get()) continue;
            
            // Get interpolated position
            var x = MathUtils.interpolate(entity.lastTickPosX, entity.posX, pt) - rm.renderPosX;
            var y = MathUtils.interpolate(entity.lastTickPosY, entity.posY, pt) - rm.renderPosY + entity.height / 2;
            var z = MathUtils.interpolate(entity.lastTickPosZ, entity.posZ, pt) - rm.renderPosZ;
            
            var color = getColor(entity, dist);
            
            RenderUtils.glColor(color);
            
            GL11.glBegin(GL11.GL_LINES);
            GL11.glVertex3d(0, eyeHeight, 0);
            GL11.glVertex3d(x, y, z);
            GL11.glEnd();
        }
        
        RenderUtils.releaseGL();
    });
    
    function isValidEntity(entity) {
        var player = mc.thePlayer;
        
        if (entity == player) return false;
        if (entity.isDead) return false;
        
        if (entity instanceof EntityPlayer) {
            if (!module.settings.players.get()) return false;
        } else if (entity instanceof EntityMob) {
            if (!module.settings.mobs.get()) return false;
        } else if (entity instanceof EntityAnimal) {
            if (!module.settings.animals.get()) return false;
        } else if (entity instanceof EntityItem) {
            if (!module.settings.items.get()) return false;
        } else {
            return false;
        }
        
        if (entity.isInvisible() && !module.settings.invisibles.get()) {
            return false;
        }
        
        return true;
    }
    
    function getColor(entity, distance) {
        var colorMode = module.settings.colorMode.get();
        
        switch(colorMode) {
            case "Distance":
                // Green = close, Red = far
                var maxDist = module.settings.range.get();
                var ratio = distance / maxDist;
                var r = Math.floor(ratio * 255);
                var g = Math.floor((1 - ratio) * 255);
                return 0xFF000000 | (r << 16) | (g << 8);
                
            case "Health":
                if (entity instanceof EntityLivingBase) {
                    var health = entity.getHealth();
                    var maxHealth = entity.getMaxHealth();
                    var healthRatio = health / maxHealth;
                    var r = Math.floor((1 - healthRatio) * 255);
                    var g = Math.floor(healthRatio * 255);
                    return 0xFF000000 | (r << 16) | (g << 8);
                }
                return 0xFFFFFFFF;
                
            case "Static":
                return module.settings.staticColor.get();
                
            default:
                return 0xFFFF0000;
        }
    }
});

