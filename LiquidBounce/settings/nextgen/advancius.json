    });
    
    module.on("disable", function() {
        Chat.print("§c[StorageESP] §fDisabled!");
    });
    
    module.on("render3D", function(event) {
        var player = mc.thePlayer;
        var world = mc.theWorld;
        if (player == null || world == null) return;
        
        RenderUtils.prepareGL();
        GL11.glLineWidth(1.5);
        
        var rm = mc.getRenderManager();
        var range = module.settings.range.get();
        
        // Get all tile entities
        var tileEntities = world.loadedTileEntityList;
        
        for (var i = 0; i < tileEntities.size(); i++) {
            var te = tileEntities.get(i);
            var pos = te.getPos();
            
            // Range check
            var dist = MathUtils.getDistance(
                player.posX, player.posY, player.posZ,
                pos.getX(), pos.getY(), pos.getZ()
            );
            if (dist > range) continue;
            
            var color = getStorageColor(te);
            if (color == -1) continue;
            
            var x = pos.getX() - rm.renderPosX;
            var y = pos.getY() - rm.renderPosY;
            var z = pos.getZ() - rm.renderPosZ;
            
            var bb = new AxisAlignedBB(x, y, z, x + 1, y + 1, z + 1);
            
            var mode = module.settings.mode.get();
            
            if (mode == "Box" || mode == "Both") {
                RenderUtils.drawFilledBox(bb, (color & 0x00FFFFFF) | 0x40000000);
            }
            
            if (mode == "Outline" || mode == "Both") {
                RenderUtils.drawBox(bb, color);
            }
        }
        
        RenderUtils.releaseGL();
    });
    
    function getStorageColor(tileEntity) {
        // Check chest
        if (tileEntity instanceof TileEntityChest) {
            if (module.settings.chests.get()) {
                return module.settings.chestColor.get();
            }
        }
        
        // Check ender chest
        if (tileEntity instanceof TileEntityEnderChest) {
            if (module.settings.enderChests.get()) {
                return module.settings.enderChestColor.get();
            }
        }
        
        // Check shulker box
        if (tileEntity instanceof TileEntityShulkerBox) {
            if (module.settings.shulkerBoxes.get()) {
                return module.settings.shulkerColor.get();
            }
        }
        
        // Check barrel
        if (tileEntity instanceof TileEntityBarrel) {
            if (module.settings.barrels.get()) {
                return module.settings.barrelColor.get();
            }
        }
        
        // Check hopper
        if (tileEntity instanceof TileEntityHopper) {
            if (module.settings.hoppers.get()) {
                return module.settings.otherColor.get();
            }
        }
        
        // Check dispenser
        if (tileEntity instanceof TileEntityDispenser) {
            if (module.settings.dispensers.get()) {
                return module.settings.otherColor.get();
            }
        }
        
        // Check dropper
        if (tileEntity instanceof TileEntityDropper) {
            if (module.settings.droppers.get()) {
                return module.settings.otherColor.get();
            }
        }
        
        // Check furnace
        if (tileEntity instanceof TileEntityFurnace) {
            if (module.settings.furnaces.get()) {
                return module.settings.otherColor.get();
            }
        }
        
        return -1;
    }
});

