/**
 * Aimbot Module - Tự động ngắm vào entity
 */
var script = registerScript({
    name: "Aimbot",
    version: "1.0.0",
    authors: ["CustomDev"]
});

script.registerModule({
    name: "Aimbot",
    description: "Automatically aims at entities",
    category: "Combat",
    settings: {
        range: Setting.float({
            name: "Range",
            default: 4.5,
            min: 1.0,
            max: 8.0
        }),
        speed: Setting.float({
            name: "Speed",
            default: 5.0,
            min: 1.0,
            max: 20.0
        }),
        fov: Setting.float({
            name: "FOV",
            default: 180.0,
            min: 30.0,
            max: 180.0
        }),
        smoothing: Setting.boolean({
            name: "Smoothing",
            default: true
        }),
        prediction: Setting.boolean({
            name: "Prediction",
            default: true
        }),
        predictionStrength: Setting.float({
            name: "PredictionStrength",
            default: 1.0,
            min: 0.1,
            max: 3.0
        }),
        aimPart: Setting.list({
            name: "AimPart",
            default: "Head",
            values: ["Head", "Body", "Feet", "Closest"]
        }),
        priority: Setting.list({
            name: "Priority",
            default: "Distance",
            values: ["Distance", "Health", "Angle", "HurtTime"]
        }),
        players: Setting.boolean({
            name: "Players",
            default: true
        }),
        mobs: Setting.boolean({
            name: "Mobs",
            default: false
        }),
        animals: Setting.boolean({
            name: "Animals",
            default: false
        }),
        invisibles: Setting.boolean({
            name: "Invisibles",
            default: false
        }),
        onlyOnClick: Setting.boolean({
            name: "OnlyOnClick",
            default: false
        })
    }
}, function(module) {
    var targetYaw = 0;
    var targetPitch = 0;
    
    module.on("enable", function() {
        Chat.print("§a[Aimbot] §fEnabled!");
    });
    
    module.on("disable", function() {
        Chat.print("§c[Aimbot] §fDisabled!");
    });
    
    module.on("update", function() {
        var player = mc.thePlayer;
        if (player == null) return;
        
        // Check if only on click
        if (module.settings.onlyOnClick.get() && !mc.gameSettings.keyBindAttack.isKeyDown()) {
            return;
        }
        
        var target = getTarget();
        if (target == null) return;
        
        var aimPos = getAimPosition(target);
        var rotations = RotationUtils.getRotationsToPos(aimPos.x, aimPos.y, aimPos.z);
        
        if (rotations == null) return;
        
        // Apply prediction
        if (module.settings.prediction.get()) {
            var strength = module.settings.predictionStrength.get();
            rotations.yaw += (target.posX - target.prevPosX) * 10 * strength;
            rotations.pitch -= (target.posY - target.prevPosY) * 10 * strength;
        }
        
        // Apply smoothing
        if (module.settings.smoothing.get()) {
            var speed = module.settings.speed.get();
            player.rotationYaw = RotationUtils.smoothRotation(player.rotationYaw, rotations.yaw, speed);
            player.rotationPitch = RotationUtils.smoothRotation(player.rotationPitch, rotations.pitch, speed);
        } else {
            player.rotationYaw = rotations.yaw;
            player.rotationPitch = rotations.pitch;
        }
        
        // Clamp pitch
        player.rotationPitch = MathUtils.clamp(player.rotationPitch, -90, 90);
    });
    
    function getTarget() {
        var player = mc.thePlayer;
        var world = mc.theWorld;
        var targets = [];
        
        var entities = world.loadedEntityList;
        for (var i = 0; i < entities.size(); i++) {
            var entity = entities.get(i);
            
            if (!isValidTarget(entity)) continue;
            
            targets.push(entity);
        }
        
        if (targets.length == 0) return null;
        
        // Sort by priority
        var priority = module.settings.priority.get();
        switch(priority) {
            case "Distance":
                targets.sort(function(a, b) {
                    return player.getDistanceToEntity(a) - player.getDistanceToEntity(b);
                });
                break;
            case "Health":
                targets.sort(function(a, b) {
                    return a.getHealth() - b.getHealth();
                });
                break;
            case "Angle":
                targets.sort(function(a, b) {
                    return RotationUtils.getAngleDifference(a) - RotationUtils.getAngleDifference(b);
                });
                break;
            case "HurtTime":
                targets.sort(function(a, b) {
                    return a.hurtTime - b.hurtTime;
                });
                break;
        }
        
        return targets[0];
    }
    
    function isValidTarget(entity) {
        var player = mc.thePlayer;
        
        if (entity == player) return false;
        if (!(entity instanceof EntityLivingBase)) return false;
        if (entity.isDead) return false;
        if (entity.getHealth() <= 0) return false;
        
        var dist = player.getDistanceToEntity(entity);
        if (dist > module.settings.range.get()) return false;
        
        // FOV check
        var angle = RotationUtils.getAngleDifference(entity);
        if (angle > module.settings.fov.get() / 2) return false;
        
        // Entity type checks
        if (entity instanceof EntityPlayer) {
            if (!module.settings.players.get()) return false;
        } else if (entity instanceof EntityMob) {
            if (!module.settings.mobs.get()) return false;
        } else if (entity instanceof EntityAnimal) {
            if (!module.settings.animals.get()) return false;
        } else {
            return false;
        }
        
        // Invisibility check
        if (entity.isInvisible() && !module.settings.invisibles.get()) {
            return false;
        }
        
        return true;
    }
    
    function getAimPosition(entity) {
        var aimPart = module.settings.aimPart.get();
        var x = entity.posX;
        var y;
        var z = entity.posZ;
        
        switch(aimPart) {
            case "Head":
                y = entity.posY + entity.getEyeHeight();
                break;
            case "Body":
                y = entity.posY + entity.height / 2;
                break;
            case "Feet":
                y = entity.posY;
                break;
            case "Closest":
                var playerEyeY = mc.thePlayer.posY + mc.thePlayer.getEyeHeight();
                y = MathUtils.clamp(playerEyeY, entity.posY, entity.posY + entity.height);
                break;
            default:
                y = entity.posY + entity.getEyeHeight();
        }
        
        return {x: x, y: y, z: z};
    }
});

