var nukerScript = registerScript({
    name: "Nuker",
    version: "1.0.0",
    authors: ["CustomDev"]
});

nukerScript.registerModule({
    name: "Nuker",
    description: "Breaks blocks around you automatically",
    category: "World",
    settings: {
        range: Setting.float({
            name: "Range",
            default: 4.5,
            min: 1.0,
            max: 6.0
        }),
        mode: Setting.list({
            name: "Mode",
            default: "All",
            values: ["All", "Flat", "Smash", "Specific"]
        }),
        delay: Setting.integer({
            name: "Delay",
            default: 50,
            min: 0,
            max: 500
        }),
        rotations: Setting.boolean({
            name: "Rotations",
            default: true
        }),
        swing: Setting.boolean({
            name: "Swing",
            default: true
        }),
        autoTool: Setting.boolean({
            name: "AutoTool",
            default: true
        }),
        throughWalls: Setting.boolean({
            name: "ThroughWalls",
            default: false
        }),
        specificBlock: Setting.text({
            name: "SpecificBlock",
            default: "stone"
        }),
        filterBlocks: Setting.text({
            name: "FilterBlocks",
            default: "bedrock,obsidian"
        })
    }
}, function(module) {
    var lastBreak = 0;
    var currentBlock = null;
    var breakProgress = 0;
    
    module.on("enable", function() {
        Chat.print("§a[Nuker] §fEnabled!");
        currentBlock = null;
        breakProgress = 0;
    });
    
    module.on("disable", function() {
        Chat.print("§c[Nuker] §fDisabled!");
        if (currentBlock != null) {
            mc.playerController.resetBlockRemoving();
        }
    });
    
    module.on("update", function() {
        var player = mc.thePlayer;
        var world = mc.theWorld;
        if (player == null || world == null) return;
        
        var currentTime = Date.now();
        if (currentTime - lastBreak < module.settings.delay.get()) return;
        
        var target = findBlock();
        if (target == null) {
            if (currentBlock != null) {
                mc.playerController.resetBlockRemoving();
                currentBlock = null;
            }
            return;
        }
        
        // Auto tool
        if (module.settings.autoTool.get()) {
            switchToBestTool(target);
        }
        
        // Rotations
        if (module.settings.rotations.get()) {
            var rotations = RotationUtils.getRotationsToPos(
                target.getX() + 0.5,
                target.getY() + 0.5,
                target.getZ() + 0.5
            );
            player.rotationYaw = rotations.yaw;
            player.rotationPitch = rotations.pitch;
        }
        
        // Break block
        if (currentBlock == null || !currentBlock.equals(target)) {
            currentBlock = target;
            mc.playerController.onPlayerDamageBlock(target, EnumFacing.UP);
        }
        
        if (mc.playerController.onPlayerDamageBlock(target, EnumFacing.UP)) {
            if (module.settings.swing.get()) {
                player.swingArm(EnumHand.MAIN_HAND);
            }
        }
        
        // Check if block is broken
        var block = world.getBlockState(target).getBlock();
        if (block == Blocks.AIR) {
            currentBlock = null;
            lastBreak = currentTime;
        }
    });
    
    function findBlock() {
        var player = mc.thePlayer;
        var range = module.settings.range.get();
        var mode = module.settings.mode.get();
        
        var playerX = Math.floor(player.posX);
        var playerY = Math.floor(player.posY);
        var playerZ = Math.floor(player.posZ);
        
        var closestBlock = null;
        var closestDist = range + 1;
        
        var rangeInt = Math.ceil(range);
        
        for (var x = -rangeInt; x <= rangeInt; x++) {
            for (var y = -rangeInt; y <= rangeInt; y++) {
                for (var z = -rangeInt; z <= rangeInt; z++) {
                    var pos = new BlockPos(playerX + x, playerY + y, playerZ + z);
                    var block = mc.theWorld.getBlockState(pos).getBlock();
                    
                    if (block == Blocks.AIR) continue;
                    
                    // Filter blocks
                    if (isFiltered(block)) continue;
                    
                    // Mode checks
                    if (mode == "Flat" && y >= 0) continue;
                    if (mode == "Smash" && block.getBlockHardness(block.getDefaultState(), mc.theWorld, pos) > 0) continue;
                    if (mode == "Specific" && !isSpecificBlock(block)) continue;
                    
                    // Distance check
                    var dist = MathUtils.getDistance(
                        player.posX, player.posY + player.getEyeHeight(), player.posZ,
                        pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5
                    );
                    
                    if (dist > range) continue;
                    
                    // Raycast check
                    if (!module.settings.throughWalls.get()) {
                        // Simple visibility check
                        if (!canSeeBlock(pos)) continue;
                    }
                    
                    if (dist < closestDist) {
                        closestDist = dist;
                        closestBlock = pos;
                    }
                }
            }
        }
        
        return closestBlock;
    }
    
    function isFiltered(block) {
        var filterBlocks = module.settings.filterBlocks.get().split(",");
        var blockName = getBlockName(block);
        
        for (var i = 0; i < filterBlocks.length; i++) {
            if (blockName == filterBlocks[i].trim()) {
                return true;
            }
        }
        
        return false;
    }
    
    function isSpecificBlock(block) {
        var specificBlock = module.settings.specificBlock.get();
        var blockName = getBlockName(block);
        
        return blockName == specificBlock;
    }
    
    function getBlockName(block) {
        var registry = Block.REGISTRY;
        var resourceLocation = registry.getNameForObject(block);
        if (resourceLocation != null) {
            return resourceLocation.getResourcePath();
        }
        return "";
    }
    
    function canSeeBlock(pos) {
        var player = mc.thePlayer;
        var start = new Vec3d(player.posX, player.posY + player.getEyeHeight(), player.posZ);
        var end = new Vec3d(pos.getX() + 0.5, pos.getY() + 0.5, pos.getZ() + 0.5);
        
        var result = mc.theWorld.rayTraceBlocks(start, end, false, true, false);
        
        if (result == null) return true;
        return result.getBlockPos().equals(pos);
    }
    
    function switchToBestTool(pos) {
        var player = mc.thePlayer;
        var block = mc.theWorld.getBlockState(pos);
        
        var bestSlot = -1;
        var bestSpeed = 1.0;
        
        for (var i = 0; i < 9; i++) {
            var stack = player.inventory.getStackInSlot(i);
            if (stack == null) continue;
            
            var speed = stack.getDestroySpeed(block);
            if (speed > bestSpeed) {
                bestSpeed = speed;
                bestSlot = i;
            }
        }
        
        if (bestSlot != -1) {
            player.inventory.currentItem = bestSlot;
        }
    }
});

/**
 * FastBreak Module - Break blocks faster
 */
var fastBreakScript = registerScript({
    name: "FastBreak",
    version: "1.0.0",
    authors: ["CustomDev"]
});

fastBreakScript.registerModule({
    name: "FastBreak",
    description: "Break blocks faster",
    category: "World",
    settings: {
        mode: Setting.list({
            name: "Mode",
            default: "Damage",
            values: ["Damage", "Instant", "Abort"]
        }),
        damageMultiplier: Setting.float({
            name: "DamageMultiplier",
            default: 1.5,
            min: 1.0,
            max: 5.0
        }),
        abortDelay: Setting.integer({
            name: "AbortDelay",
            default: 100,
            min: 0,
            max: 500
        })
    }
}, function(module) {
    var lastAbort = 0;
    
    module.on("enable", function() {
        Chat.print("§a[FastBreak] §fEnabled!");
    });
    
    module.on("disable", function() {
        Chat.print("§c[FastBreak] §fDisabled!");
    });
    
    module.on("update", function() {
        var player = mc.thePlayer;
        if (player == null) return;
        
        var mode = module.settings.mode.get();
        
        if (mode == "Damage") {
            // Increase break speed by modifying current break progress
            var multiplier = module.settings.damageMultiplier.get();
            mc.playerController.curBlockDamageMP *= multiplier;
            
            // Cap at 1.0
            if (mc.playerController.curBlockDamageMP > 1.0) {
                mc.playerController.curBlockDamageMP = 1.0;
            }
        }
    });
    
    module.on("blockBreakingProgress", function(event) {
        var mode = module.settings.mode.get();
        
        if (mode == "Instant") {
            event.setCancelled(true);
            
            var pos = event.getBlockPos();
            mc.playerController.onPlayerDestroyBlock(pos);
            mc.thePlayer.swingArm(EnumHand.MAIN_HAND);
        }
        else if (mode == "Abort") {
            var currentTime = Date.now();
            if (currentTime - lastAbort > module.settings.abortDelay.get()) {
                // Send abort and restart packet
                mc.playerController.resetBlockRemoving();
                lastAbort = currentTime;
            }
        }
    });
});

