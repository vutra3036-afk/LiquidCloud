// ============================================================
//                    UTILITY FUNCTIONS
// ============================================================

var MathUtils = {
    toRadians: function(degrees) {
        return degrees * Math.PI / 180.0;
    },
    
    toDegrees: function(radians) {
        return radians * 180.0 / Math.PI;
    },
    
    getDistance: function(x1, y1, z1, x2, y2, z2) {
        var dx = x2 - x1;
        var dy = y2 - y1;
        var dz = z2 - z1;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    },
    
    getDistance2D: function(x1, z1, x2, z2) {
        var dx = x2 - x1;
        var dz = z2 - z1;
        return Math.sqrt(dx * dx + dz * dz);
    },
    
    clamp: function(value, min, max) {
        return Math.max(min, Math.min(max, value));
    },
    
    randomFloat: function(min, max) {
        return min + Math.random() * (max - min);
    },
    
    randomInt: function(min, max) {
        return Math.floor(min + Math.random() * (max - min + 1));
    },
    
    interpolate: function(old, current, partialTicks) {
        return old + (current - old) * partialTicks;
    }
};

var RotationUtils = {
    getRotations: function(entity) {
        var player = mc.thePlayer;
        if (player == null || entity == null) return null;
        
        var diffX = entity.posX - player.posX;
        var diffY = (entity.posY + entity.getEyeHeight()) - (player.posY + player.getEyeHeight());
        var diffZ = entity.posZ - player.posZ;
        
        var dist = Math.sqrt(diffX * diffX + diffZ * diffZ);
        var yaw = MathUtils.toDegrees(Math.atan2(diffZ, diffX)) - 90.0;
        var pitch = -MathUtils.toDegrees(Math.atan2(diffY, dist));
        
        return {yaw: yaw, pitch: pitch};
    },
    
    getRotationsToPos: function(x, y, z) {
        var player = mc.thePlayer;
        if (player == null) return null;
        
        var diffX = x - player.posX;
        var diffY = y - (player.posY + player.getEyeHeight());
        var diffZ = z - player.posZ;
        
        var dist = Math.sqrt(diffX * diffX + diffZ * diffZ);
        var yaw = MathUtils.toDegrees(Math.atan2(diffZ, diffX)) - 90.0;
        var pitch = -MathUtils.toDegrees(Math.atan2(diffY, dist));
        
        return {yaw: yaw, pitch: pitch};
    },
    
    smoothRotation: function(currentYaw, targetYaw, speed) {
        var diff = this.wrapAngleTo180(targetYaw - currentYaw);
        if (Math.abs(diff) <= speed) {
            return targetYaw;
        }
        return currentYaw + (diff > 0 ? speed : -speed);
    },
    
    wrapAngleTo180: function(angle) {
        angle = angle % 360.0;
        if (angle >= 180.0) angle -= 360.0;
        if (angle < -180.0) angle += 360.0;
        return angle;
    },
    
    getAngleDifference: function(entity) {
        var player = mc.thePlayer;
        var rotations = this.getRotations(entity);
        if (rotations == null) return 180;
        
        var yawDiff = Math.abs(this.wrapAngleTo180(player.rotationYaw - rotations.yaw));
        var pitchDiff = Math.abs(player.rotationPitch - rotations.pitch);
        
        return Math.sqrt(yawDiff * yawDiff + pitchDiff * pitchDiff);
    }
};

var MovementUtils = {
    isMoving: function() {
        var player = mc.thePlayer;
        return player.moveForward != 0 || player.moveStrafing != 0;
    },
    
    getSpeed: function() {
        var player = mc.thePlayer;
        return Math.sqrt(player.motionX * player.motionX + player.motionZ * player.motionZ);
    },
    
    strafe: function(speed) {
        var player = mc.thePlayer;
        if (!this.isMoving()) return;
        
        var yaw = this.getDirection();
        player.motionX = -Math.sin(yaw) * speed;
        player.motionZ = Math.cos(yaw) * speed;
    },
    
    getDirection: function() {
        var player = mc.thePlayer;
        var yaw = player.rotationYaw;
        
        if (player.moveForward < 0) yaw += 180;
        
        var forward = 1;
        if (player.moveForward < 0) forward = -0.5;
        else if (player.moveForward > 0) forward = 0.5;
        
        if (player.moveStrafing > 0) yaw -= 90 * forward;
        if (player.moveStrafing < 0) yaw += 90 * forward;
        
        return MathUtils.toRadians(yaw);
    },
    
    setMotion: function(speed) {
        var player = mc.thePlayer;
        var yaw = this.getDirection();
        player.motionX = -Math.sin(yaw) * speed;
        player.motionZ = Math.cos(yaw) * speed;
    }
};

var BlockUtils = {
    getBlock: function(x, y, z) {
        return mc.theWorld.getBlockState(new BlockPos(x, y, z)).getBlock();
    },
    
    getBlockPos: function(x, y, z) {
        return new BlockPos(Math.floor(x), Math.floor(y), Math.floor(z));
    },
    
    isAir: function(x, y, z) {
        return this.getBlock(x, y, z) == Blocks.AIR;
    },
    
    isSolid: function(x, y, z) {
        var block = this.getBlock(x, y, z);
        return block.isFullBlock(block.getDefaultState());
    },
    
    isLiquid: function(x, y, z) {
        var block = this.getBlock(x, y, z);
        return block instanceof BlockLiquid;
    },
    
    canPlaceBlock: function(pos) {
        var block = mc.theWorld.getBlockState(pos).getBlock();
        return block == Blocks.AIR || block instanceof BlockLiquid;
    },
    
    getPlaceSide: function(pos) {
        var sides = [
            EnumFacing.DOWN, EnumFacing.UP,
            EnumFacing.NORTH, EnumFacing.SOUTH,
            EnumFacing.WEST, EnumFacing.EAST
        ];
        
        for (var i = 0; i < sides.length; i++) {
            var side = sides[i];
            var offsetPos = pos.offset(side);
            var block = mc.theWorld.getBlockState(offsetPos).getBlock();
            
            if (block != Blocks.AIR && !(block instanceof BlockLiquid)) {
                return {pos: offsetPos, face: side.getOpposite()};
            }
        }
        return null;
    }
};

var InventoryUtils = {
    findItem: function(itemClass) {
        var player = mc.thePlayer;
        for (var i = 0; i < 9; i++) {
            var stack = player.inventory.getStackInSlot(i);
            if (stack != null && stack.getItem() instanceof itemClass) {
                return i;
            }
        }
        return -1;
    },
    
    findBlock: function() {
        var player = mc.thePlayer;
        for (var i = 0; i < 9; i++) {
            var stack = player.inventory.getStackInSlot(i);
            if (stack != null && stack.getItem() instanceof ItemBlock) {
                return i;
            }
        }
        return -1;
    },
    
    getBlockCount: function() {
        var player = mc.thePlayer;
        var count = 0;
        for (var i = 0; i < 36; i++) {
            var stack = player.inventory.getStackInSlot(i);
            if (stack != null && stack.getItem() instanceof ItemBlock) {
                count += stack.stackSize;
            }
        }
        return count;
    },
    
    switchToSlot: function(slot) {
        mc.thePlayer.inventory.currentItem = slot;
    }
};

var RenderUtils = {
    glColor: function(color) {
        var r = (color >> 16 & 0xFF) / 255.0;
        var g = (color >> 8 & 0xFF) / 255.0;
        var b = (color & 0xFF) / 255.0;
        var a = (color >> 24 & 0xFF) / 255.0;
        GL11.glColor4f(r, g, b, a);
    },
    
    drawBox: function(bb, color) {
        this.glColor(color);
        
        GL11.glBegin(GL11.GL_LINE_STRIP);
        GL11.glVertex3d(bb.minX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.minY, bb.minZ);
        GL11.glEnd();
        
        GL11.glBegin(GL11.GL_LINE_STRIP);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.minZ);
        GL11.glEnd();
        
        GL11.glBegin(GL11.GL_LINES);
        GL11.glVertex3d(bb.minX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.minZ);
        GL11.glEnd();
    },
    
    drawFilledBox: function(bb, color) {
        this.glColor(color);
        
        GL11.glBegin(GL11.GL_QUADS);
        // Bottom
        GL11.glVertex3d(bb.minX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.minX, bb.minY, bb.maxZ);
        // Top
        GL11.glVertex3d(bb.minX, bb.maxY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.minZ);
        // Front
        GL11.glVertex3d(bb.minX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.minZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.minZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.minZ);
        // Back
        GL11.glVertex3d(bb.minX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.maxZ);
        // Left
        GL11.glVertex3d(bb.minX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.minX, bb.minY, bb.maxZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.minX, bb.maxY, bb.minZ);
        // Right
        GL11.glVertex3d(bb.maxX, bb.minY, bb.minZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.minZ);
        GL11.glVertex3d(bb.maxX, bb.maxY, bb.maxZ);
        GL11.glVertex3d(bb.maxX, bb.minY, bb.maxZ);
        GL11.glEnd();
    },
    
    drawLine3D: function(x1, y1, z1, x2, y2, z2, color, width) {
        this.glColor(color);
        GL11.glLineWidth(width);
        
        GL11.glBegin(GL11.GL_LINES);
        GL11.glVertex3d(x1, y1, z1);
        GL11.glVertex3d(x2, y2, z2);
        GL11.glEnd();
    },
    
    prepareGL: function() {
        GL11.glPushMatrix();
        GL11.glEnable(GL11.GL_BLEND);
        GL11.glBlendFunc(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA);
        GL11.glDisable(GL11.GL_TEXTURE_2D);
        GL11.glDisable(GL11.GL_DEPTH_TEST);
        GL11.glDepthMask(false);
    },
    
    releaseGL: function() {
        GL11.glDepthMask(true);
        GL11.glEnable(GL11.GL_DEPTH_TEST);
        GL11.glEnable(GL11.GL_TEXTURE_2D);
        GL11.glDisable(GL11.GL_BLEND);
        GL11.glPopMatrix();
    }
};

